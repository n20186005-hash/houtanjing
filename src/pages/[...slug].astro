---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqList from "../components/FaqList.astro";
import { pages, pageBySlug, type ContentPage } from "../data/content";
import { mapLinks, place } from "../data/site";

export function getStaticPaths() {
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: ContentPage;
}

const { page } = Astro.props;
const images = {
  sunset: { src: "/images/houtanjing-sunset.jpg", alt: "猴探井天空之橋、八卦山谷與西向夕陽" },
  bridge: { src: "/images/houtanjing-bridge.jpg", alt: "猴探井天空之橋橫跨八卦山谷" },
  "sunny-hills": { src: "/images/sunny-hills-courtyard.jpg", alt: "南投微熱山丘三合院實景，傳統院落與低矮建築" },
  "zhongxing-village": { src: "/images/zhongxing-village-street.jpg", alt: "南投中興新村街道實景" },
  "zhongxing-hall": { src: "/images/zhongxing-hall.jpg", alt: "南投中興新村中興會堂白色歷史建築實景" },
  "provincial-archives": { src: "/images/provincial-archives.jpg", alt: "南投臺灣省政資料館歷史建築實景" },
  "route-139": { src: "/images/route-139-green-tunnel.jpg", alt: "八卦山縣道139線綠色隧道林蔭道路實景" },
  "dream-factory": { src: "/images/babbuza-dream-factory.png", alt: "南投樹德半山夢工廠建築與展示空間實景" },
};
const { src: imagePath, alt: imageAlt } = images[page.image];
const relatedPages = page.related
  .map((slug) => pageBySlug[slug])
  .filter((related): related is ContentPage => Boolean(related));
const breadcrumbs = [
  { name: "首頁", url: "/" },
  { name: page.shortTitle, url: `/${page.slug}` },
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  image={imagePath}
  breadcrumbs={breadcrumbs}
  faqs={page.faqs ?? []}
>
  <header class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <nav class="breadcrumbs" aria-label="麵包屑導覽">
          <a href="/">首頁</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{page.shortTitle}</span>
        </nav>
        <p class="eyebrow eyebrow-light">{page.eyebrow}</p>
        <h1>{page.displayName ?? page.title}</h1>
        {page.tagline && <p class="profile-tagline">{page.tagline}</p>}
        <p class="page-lead">{page.lead}</p>
        {page.profile && page.map && (
          <div class="profile-hero-meta">
            <span>營業・費用：依各景點官方及現場資訊</span>
            <a href={page.map.url} target="_blank" rel="noopener noreferrer">📍 {page.map.name}地圖 ↗</a>
          </div>
        )}
        {
          page.facts && (
            <div class="page-facts" aria-label="頁面重點資訊">
              {page.facts.map((fact) => (
                <div class="page-fact">
                  <strong>{fact.value}</strong>
                  <span>{fact.label}</span>
                </div>
              ))}
            </div>
          )
        }
      </div>
      <figure class="page-hero-image">
        <img src={imagePath} alt={imageAlt} width="1189" height="768" loading="eager" />
        <figcaption class="image-caption">
          {page.imageCredit ?? "景觀影像：交通部觀光署參山國家風景區管理處（本圖片版權歸原攝影者所有）"}
        </figcaption>
      </figure>
    </div>
  </header>

  {page.about && (
    <section class="section attraction-about" aria-labelledby="about-place-title">
      <div class="container attraction-about-inner">
        <div>
          <p class="eyebrow">關於景點 · 管理與文化</p>
          <h2 id="about-place-title">{page.about.heading}</h2>
        </div>
        <div>
          <p>{page.about.text}</p>
          <a href={page.about.source} target="_blank" rel="noopener noreferrer">管理與背景資料：{page.about.sourceLabel} ↗</a>
        </div>
      </div>
    </section>
  )}

  {page.profile && (
    <section class="section profile-discover">
      <div class="container profile-discover-grid">
        <div>
          <p class="eyebrow">DISCOVER</p>
          <h2>探索{page.map?.name ?? page.shortTitle}</h2>
          <p>{page.profile.intro}</p>
        </div>
        <div class="profile-discover-aside">
          <h3>遊覽建議</h3>
          <ul>{page.profile.tips.map((tip) => <li>{tip}</li>)}</ul>
          <h3>景區特色</h3>
          <ul>{page.profile.highlights.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </section>
  )}

  {page.profile && (
    <section class="section profile-details">
      <div class="container profile-details-inner">
        <p class="eyebrow">PRACTICAL INFORMATION</p>
        <h2>基本資料</h2>
        <dl class="profile-fact-list">{page.profile.basic.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
        <div class="profile-info-grid">
          <section><h2>開放時間</h2><p>{page.profile.hours}</p></section>
          <section><h2>門票價格</h2><p>{page.profile.tickets}</p></section>
        </div>
        <section class="profile-block">
          <h2>交通方式</h2>
          <div class="profile-info-grid">{page.profile.transport.map((way) => <div><h3>{way.label}</h3><p>{way.text}</p></div>)}</div>
        </section>
        <section class="profile-block">
          <h2>發現魅力</h2>
          <div class="profile-info-grid">{page.profile.charm.map((feature) => <div><h3>{feature.title}</h3><p>{feature.text}</p></div>)}</div>
        </section>
        <section class="profile-block">
          <h2>推薦遊覽路線</h2>
          <ol class="profile-route">{page.profile.route.map((step) => <li>{step}</li>)}</ol>
        </section>
        <div class="profile-info-grid profile-block">
          <section><h2>遊覽須知</h2><ul>{page.profile.guidelines.map((item) => <li>{item}</li>)}</ul></section>
          <section><h2>拍照機位</h2><ol>{page.profile.photoSpots.map((item) => <li>{item}</li>)}</ol></section>
        </div>
        <div class="profile-info-grid profile-block">
          <section><h2>住宿建議</h2><p>{page.profile.lodging}</p></section>
          <section><h2>遊客評價</h2><p>{page.profile.reviews}</p><a href={page.map?.url} target="_blank" rel="noopener noreferrer">查看此景點 Google 地圖公開評價 ↗</a></section>
        </div>
        <p class="profile-verified">資料核對：{page.profile.checkedAt}。如遇營運異動，以當日主管或營運單位公告為準。</p>
      </div>
    </section>
  )}

  <article class="section">
    <div class="container article-grid">
      <div class="article-main">
        {page.profile && <h2 class="profile-extra-heading">深入閱讀與延伸建議</h2>}
        {
          page.sections.map((section, index) => (
            <section class="content-section" id={`section-${index + 1}`}>
              {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
              <h2>{section.title}</h2>
              {section.body && <p>{section.body}</p>}
              {section.items && (
                <ul class="content-list">
                  {section.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
              {section.href && <p><a class="btn btn-outline" href={section.href}>閱讀完整景點介紹與專屬導航 →</a></p>}
            </section>
          ))
        }

        {
          page.faqs && (
            <section class="content-section" aria-labelledby="faq-page-title">
              <p class="eyebrow">FAQ</p>
              <h2 id="faq-page-title">最常被問的行前問題</h2>
              <div style="margin-top: 24px;">
                <FaqList items={page.faqs} />
              </div>
            </section>
          )
        }

        {page.map && (
          <section class="content-section" id="place-navigation">
            <p class="eyebrow">獨立景點導航</p>
            <h2>{page.map.name}位置與交通查詢</h2>
            <p>{page.map.address}。地圖已依本頁景點分別設定；實際交通與入口位置請以地圖與現場告示為準。</p>
            <div class="map-actions">
              <a class="btn btn-dark" href={page.map.url} target="_blank" rel="noopener noreferrer">查看{page.map.name}地圖 ↗</a>
              <a class="btn btn-outline" href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(page.map.name + ' ' + page.map.address)}`} target="_blank" rel="noopener noreferrer">導航至{page.map.name} ↗</a>
            </div>
          </section>
        )}

        {
          page.slug === "map" && (
            <section class="content-section">
              <p class="eyebrow">互動地圖</p>
              <h2>猴探井天空之橋位置</h2>
              <p>
                {place.address}。地圖載入後可縮放查看周邊道路；規劃路線請使用下方導航按鈕。
              </p>
              <div class="map-article" style="margin-top: 26px;">
                <iframe
                  src={mapLinks.embed}
                  title="猴探井天空之橋 Google 地圖"
                  width="600"
                  height="450"
                  style="border:0;"
                  loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                />
              </div>
              <div class="map-actions">
                <a
                  class="btn btn-dark"
                  href={mapLinks.search}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  在 Google 地圖開啟
                </a>
                <a
                  class="btn btn-outline"
                  href={mapLinks.directions}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  從目前位置導航
                </a>
              </div>
            </section>
          )
        }

        {page.callout && (
          <aside class="callout">
            <p>{page.callout}</p>
            {page.slug === "history" && (
              <div class="callout-cta">
                <a class="btn btn-dark" href="/visit">查看 2026 門票與開放時間</a>
                <a class="btn btn-outline" href="/nearby">139 縣道周邊景點</a>
                <a class="btn btn-outline" href="/sunset">夕陽谷拍攝建議</a>
              </div>
            )}
          </aside>
        )}
      </div>

      <aside class="article-aside" aria-label="本頁內容">
        <strong>本頁內容</strong>
        {
          page.sections.map((section, index) => (
            <a href={`#section-${index + 1}`}>{section.title}</a>
          ))
        }
        {page.faqs && <a href="#faq-page-title">常見問題</a>}
        <a href={page.map?.url ?? mapLinks.search} target="_blank" rel="noopener noreferrer">
          開啟 Google 地圖 ↗
        </a>
      </aside>
    </div>
  </article>

  {
    relatedPages.length > 0 && (
      <section class="related-wrap">
        <div class="container">
          <h2>接著規劃</h2>
          <div class="related-grid">
            {relatedPages.map((related) => (
              <a class="related-card" href={`/${related.slug}`}>
                <span>READ NEXT</span>
                {related.shortTitle}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
